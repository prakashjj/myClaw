{
  "name": "myclaw",
  "version": "1.0.0",
  "description": "The superior AI agent platform. Tiny core, plugin architecture, security-first.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "myclaw": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "chat": "tsx src/cli.ts chat",
    "setup": "npm install && npm run build",
    "prepublishOnly": "npm run build",
    "postinstall": "npm run build || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "secure": "node dist/cli.js secure"
  },
  "keywords": [
    "ai",
    "agent",
    "assistant",
    "claw",
    "llm",
    "chatbot",
    "automation",
    "openrouter",
    "whatsapp",
    "telegram"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  }
}
