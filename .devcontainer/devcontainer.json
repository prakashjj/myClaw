{
  "name": "MyClaw",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm install && npm run build && node dist/cli.js init",
  "forwardPorts": [3200, 3100],
  "portsAttributes": {
    "3200": { "label": "Webhook API", "onAutoForward": "notify" },
    "3100": { "label": "WhatsApp Webhook", "onAutoForward": "notify" }
  },
  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "OPENROUTER_API_KEY": "${localEnv:OPENROUTER_API_KEY}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "TELEGRAM_BOT_TOKEN": "${localEnv:TELEGRAM_BOT_TOKEN}",
    "DISCORD_BOT_TOKEN": "${localEnv:DISCORD_BOT_TOKEN}",
    "SLACK_BOT_TOKEN": "${localEnv:SLACK_BOT_TOKEN}",
    "SLACK_APP_TOKEN": "${localEnv:SLACK_APP_TOKEN}",
    "WHATSAPP_TOKEN": "${localEnv:WHATSAPP_TOKEN}",
    "WHATSAPP_PHONE_ID": "${localEnv:WHATSAPP_PHONE_ID}",
    "WHATSAPP_VERIFY_TOKEN": "${localEnv:WHATSAPP_VERIFY_TOKEN}",
    "MYCLAW_API_TOKEN": "${localEnv:MYCLAW_API_TOKEN}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  }
}
